# Deployment Environment Configuration Template
# Copy to .env.deploy and fill in your values:
#   cp scripts/env.deploy.example .env.deploy

# Google Cloud Platform Settings
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
GCP_ARTIFACT_REPO="chat-app"
GCP_SERVICE_NAME="chat-server"
GCP_JOB_NAME="chat-server-migrate"

# Cloud SQL Settings
# Format: PROJECT_ID:REGION:INSTANCE_NAME
CLOUD_SQL_INSTANCE="your-gcp-project-id:us-central1:chat-postgres"
DB_NAME="chat_app"
DB_USER="postgres"
DB_PASSWORD="your-strong-db-password"

# Serverpod Service Passwords
# Stored securely in Secret Manager or passed at runtime
SERVERPOD_PASSWORDS_CONTENT=""

# Firebase Settings
FIREBASE_PROJECT_ID="your-firebase-project-id"
